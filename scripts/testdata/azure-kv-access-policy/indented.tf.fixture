# Fixture: an access policy declared at a non-zero indentation. Must exit 1.
#
# `terraform fmt` moves top-level blocks to column 0, and the pre-commit
# `terraform_fmt` hook (.pre-commit-config.yaml) covers every .tf file in the
# repo, both of this guard's scan roots included, because CI runs `pre-commit
# run --all-files` (.github/workflows/pre-commit.yml). The guard does not lean
# on that: a guard anchored strictly at column 0 would depend on a gate that
# could be narrowed later. This fixture pins the tolerance so it cannot be lost.

  resource "azurerm_key_vault_access_policy" "indented" {
    key_vault_id = var.key_vault_id
    tenant_id    = data.azurerm_client_config.current.tenant_id
    object_id    = azurerm_user_assigned_identity.app.principal_id

    secret_permissions = [
      "Get",
    ]
  }
